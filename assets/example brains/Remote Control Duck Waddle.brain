162,231,211,156,248,194,218,66,175,13,0,0,0,0,0,0,152,220,204,21,230,122,58,58,114,166,255,216,97,145,11,231,119,118,52,126,207,121,112,174,189,206,43,166,205,110,88,210,226,199,111,48,185,16,160,35,163,138,105,209,187,27,155,69,194,125,193,96,89,89,161,87,3,0,0,0,0,0,0,76,45,90,105,62,84,251,194,193,229,171,69,98,115,7,66,39,6,237,111,199,144,80,119,132,10,189,0,20,23,171,41,195,85,213,15,173,105,223,37,34,34,243,253,95,21,0,0,0,0,0,0,48,57,24,134,97,24,134,245,229,163,35,103,79,245,30,22,185,114,249,141,3,157,79,136,196,230,158,238,60,249,149,253,253,234,112,208,170,234,135,215,118,253,86,36,82,222,48,127,225,10,17,35,46,66,111,243,220,17,160,195,17,253,135,3,0,0,0,0,0,0,224,190,107,87,122,14,117,61,45,114,181,174,167,255,87,123,69,68,228,160,147,219,105,112,62,115,214,198,174,15,46,138,24,241,224,124,2,115,247,16,160,3,0,0,0,0,0,0,128,79,66,97,145,112,68,228,250,181,179,167,222,126,61,217,154,37,91,41,45,90,186,104,209,226,29,2,116,0,0,0,0,0,0,0,240,201,133,243,59,218,239,155,33,18,155,123,58,252,151,111,156,223,174,114,160,41,218,177,94,100,250,140,166,214,173,251,188,92,33,82,17,160,3,0,0,0,0,0,0,128,75,130,101,134,81,150,146,186,166,169,52,223,156,233,246,225,190,250,177,133,181,34,85,213,205,143,108,222,51,177,181,50,61,205,253,69,128,14,0,0,0,0,0,0,0,46,179,106,209,18,238,251,65,236,254,219,146,63,87,85,175,90,215,249,235,228,207,145,242,186,231,26,155,69,68,100,190,159,235,69,122,129,219,46,188,180,101,44,54,190,163,208,11,1,0,0,0,0,0,0,128,210,55,62,30,44,75,254,52,58,50,240,241,123,111,138,68,202,235,231,45,90,41,34,18,8,24,241,2,46,15,89,9,22,122,1,0,0,0,0,0,0,0,48,89,37,131,115,148,34,90,184,0,0,0,0,0,0,0,128,107,168,48,159,76,168,64,7,0,0,0,0,0,0,0,32,13,2,116,0,0,0,0,0,0,0,0,210,32,64,7,0,0,0,0,0,0,0,32,13,2,116,0,0,0,0,0,0,0,0,210,32,64,7,0,0,0,0,0,0,0,32,13,2,116,0,0,0,0,0,0,0,0,210,32,64,7,0,0,0,0,0,0,0,32,141,255,7,31,13,103,233,179,229,49,45,0,0,0,0,73,69,78,68,174,66,96,130],"annotations":[{"id":"1775582838125","neuronKeys":["[#16ef7]","[#1b7c3]","[#29eb6]","[#23d10]"],"edgeStrings":[],"description":"These 4 neurons will respond when you press different arrow keys on your computer or buletooth keyboard connected to this app.","thumbnail":""},{"id":"1775582877330","neuronKeys":["[#23d10]","[#1b7c3]","[#29eb6]"],"edgeStrings":["[#23d10]_#_[#edfd7]","[#1b7c3]_#_[#2fd3e]","[#29eb6]_#_[#59694]","[#29eb6]_#_[#bbf12]"],"description":"when we press the left arrow, we will rotate left, the right arrow will rotate right, and down arrow will move SpikerBot in reverse.","thumbnail":""},{"id":"1775582931058","neuronKeys":["[#29eb6]"],"edgeStrings":["[#b0bd1]_#_[#29eb6]","[#29eb6]_#_[#59694]","[#29eb6]_#_[#bbf12]"],"description":"Remote control neurons act like regular quiet type neurons when we arent pressing the specific remote control input. In this case, we will automatically make SpikerBot reverse when it gets too close to an object.","thumbnail":""},{"id":"1775583038248","neuronKeys":["[#16ef7]"],"edgeStrings":[],"description":"The real magic of the duck walk executes when we press the up arrow key.","thumbnail":""},{"id":"1775583156077","neuronKeys":["[#7300f]","[#567c1]","[#16ef7]"],"edgeStrings":["[#16ef7]_#_[#567c1]","[#16ef7]_#_[#7300f]","[#567c1]_#_[#7300f]"],"description":"When we press and hold the up arrow key, we see a familiar Feed Forward Inhibition network. The quiet excitatory neuron on the left will spike only one short burst each time we intially press the up arrow key. the inhibitory neuron will fire as long as we hold the arrow key, which will keep the rest of the duck walk cycling.","thumbnail":""},{"id":"1775583229393","neuronKeys":["[#7300f]","[#70443]","[#c0d9e]"],"edgeStrings":["[#7300f]_#_[#70443]","[#70443]_#_[#c0d9e]","[#c0d9e]_#_[#70443]"],"description":"With this first initial spike, we will stimulate a Recurrent Pair of neurons to spike until we tell them to stop. we will use this continuous spiking to make the duck walk longer for each step it takes.","thumbnail":""},{"id":"1775583315841","neuronKeys":["[#70443]","[#945b9]"],"edgeStrings":["[#70443]_#_[#945b9]"],"description":"as soon as our recurrent pair starts to spike, we start sending a signal to our first step delay neuron. The delay time will determine for how long SpikerBot will take each step forward with the motors during a waddling duck walk.","thumbnail":""},{"id":"1775583366320","neuronKeys":["[#945b9]","[#2a1ea]"],"edgeStrings":["[#945b9]_#_[#2a1ea]","[#2a1ea]_#_[#c0d9e]","[#2a1ea]_#_[#70443]"],"description":"When we hit our delay time, we will stop the Recurrent Pair from continuing to fire, locking in the cadence of our step.","thumbnail":""},{"id":"1775583454566","neuronKeys":["[#945b9]"],"edgeStrings":["[#945b9]_#_[#c1fd8]","[#945b9]_#_[#2fd3e]","[#945b9]_#_[#6d90d]","[#945b9]_#_[#a18be]"],"description":"At the same time, we will also start sending the signal to make SpikerBot waddle forward to the right, blinking its right lights, and making a low tone and start the next step.","thumbnail":""},{"id":"1775583497955","neuronKeys":["[#c1fd8]"],"edgeStrings":["[#c1fd8]_#_[#edfd7]","[#c1fd8]_#_[#945b9]","[#c1fd8]_#_[#6d90d]","[#c1fd8]_#_[#a18be]"],"description":"When the second delay hits its delay time, it will immediately switch directions, waddling to the left, blinking its left lights and making a higher pitch.","thumbnail":""},{"id":"1775583556753","neuronKeys":["[#945b9]","[#c1fd8]"],"edgeStrings":["[#945b9]_#_[#c1fd8]","[#c1fd8]_#_[#945b9]"],"description":"This delayed Reccurent pain will continue to oscillate back and forth between waddling left and right, just like a duck. it is important to set the delays to the same value, to get a consistant gait.","thumbnail":""},{"id":"1775583596771","neuronKeys":["[#30bb7]","[#945b9]","[#c1fd8]"],"edgeStrings":["[#30bb7]_#_[#c1fd8]","[#30bb7]_#_[#945b9]"],"description":"This highly active inhibitory neuron is responsible for halting our duck walk. it wants to fire without any input.","thumbnail":""},{"id":"1775583667689","neuronKeys":["[#16ef7]","[#567c1]","[#30bb7]","[#c1fd8]","[#945b9]"],"edgeStrings":["[#16ef7]_#_[#567c1]","[#567c1]_#_[#30bb7]"],"description":"As long as we hold down the up arrow, we can halt the highly active inhibitory neuron at the end of this chain. This will allow SpikerBot to keep on waddling as long as we hold down the up key.","thumbnail":""},{"id":"1775583765149","neuronKeys":["[#945b9]","[#c1fd8]"],"edgeStrings":[],"description":"how does changing the delay times change how SpikerBot 'walks'? can it waddle faster? what might happen if we have the delays set to different times?","thumbnail":""},{"id":"1775583848134","neuronKeys":["[#16ef7]","[#1b7c3]","[#23d10]","[#29eb6]"],"edgeStrings":[],"description":"what might happen if we hit multiple arrow keys at once? How can we make sure that SpikerBot always waddles when we press forward, even if we also press other keys?","thumbnail":""}],"info":{"title":"Remote Control Duck Waddle","description":"Walk and quack like a duck using your keyboard as input!","author":"User","version":"1.0.1","timestamp":"2026-04-08T17:40:14.426638"}}