,201,227,175,191,146,174,102,201,85,70,69,203,0,21,45,254,33,64,7,0,0,0,0,0,0,128,128,156,62,181,167,239,182,69,34,137,214,143,163,127,249,202,253,253,234,199,186,226,219,54,139,44,92,212,213,251,232,243,126,174,16,153,8,208,1,0,0,0,0,0,0,192,35,225,26,203,170,201,72,93,179,76,154,239,152,239,254,209,145,165,51,119,44,22,105,104,236,254,201,142,167,231,86,43,211,105,30,44,2,116,0,0,0,0,0,0,0,240,152,169,162,37,58,242,157,196,237,215,166,63,110,104,188,235,158,254,95,167,63,142,213,54,63,214,214,45,34,34,43,130,92,47,178,11,93,123,250,153,157,51,137,217,61,197,94,8,0,0,0,0,0,0,0,148,191,217,217,112,77,250,163,233,169,177,247,223,250,189,72,172,118,233,242,85,235,69,68,66,33,43,89,196,229,33,39,225,98,47,0,0,0,0,0,0,0,0,42,85,58,56,71,57,162,194,5,0,0,0,0,0,0,0,60,195,132,121,37,97,2,29,0,0,0,0,0,0,0,128,44,8,208,1,0,0,0,0,0,0,0,200,130,0,29,0,0,0,0,0,0,0,128,44,8,208,1,0,0,0,0,0,0,0,200,130,0,29,0,0,0,0,0,0,0,128,44,8,208,1,0,0,0,0,0,0,0,200,130,0,29,0,0,0,0,0,0,0,128,44,254,31,76,19,47,146,212,103,131,91,0,0,0,0,73,69,78,68,174,66,96,130],"annotations":[{"id":"1775595284742","neuronKeys":["[#3f31c]"],"edgeStrings":[],"description":"This is a remote control neuron. By default, if you do not bind a keyboard or gamepad key, you can activate this neuron by pressing the blue trigger button below the plot after you press play. As long as you hold down the button, the neuron will spike!","thumbnail":""},{"id":"1775595399569","neuronKeys":["[#3f31c]","[#bddea]","[#da8bf]"],"edgeStrings":["[#3f31c]_#_[#da8bf]","[#bddea]_#_[#da8bf]","[#3f31c]_#_[#bddea]"],"description":"Lets first condition this neuron with Feed Forward Inhibition. These three neurons work together to make the bottom most excitatory neuron spike only once when we first start to press the remote control trigger button. Until you release and re press the trigger button, the bottom excitatory neuron will not re-fire.","thumbnail":""},{"id":"1775595525439","neuronKeys":["[#24196]","[#5d0e7]"],"edgeStrings":["[#da8bf]_#_[#24196]","[#5d0e7]_#_[#24196]","[#24196]_#_[#5d0e7]"],"description":"Each time you press the trigger, the Feed Forward Inhibition output neuron will try to send its trigger to the Recurrent Pair of neurons below. When it succeeds,  the pair of neurons wil start spiking and will continue to spike indefinitely.","thumbnail":""},{"id":"1775595589681","neuronKeys":["[#60b5c]"],"edgeStrings":["[#60b5c]_#_[#24196]","[#60b5c]_#_[#5d0e7]"],"description":"This inhibitory neuron is used to stop the excitatory pair from firing. It is a quiet neuron, and will respond to the same input trigger.","thumbnail":""},{"id":"1775595816277","neuronKeys":["[#15036]","[#60b5c]"],"edgeStrings":["[#15036]_#_[#60b5c]"],"description":"This second inhibitory neuron upstream is also highly active, and this will normally disable the inhibitory neuron that wants to stop our pair of neurons.","thumbnail":""},{"id":"1775595891282","neuronKeys":["[#24196]","[#5d0e7]","[#f11fe]"],"edgeStrings":["[#24196]_#_[#5d0e7]","[#5d0e7]_#_[#24196]","[#5d0e7]_#_[#f11fe]","[#5d0e7]_#_[#3535d]"],"description":"When the Recurrent Pair is active and firing continuously, it will turn on SpikerBot’s lights. It will also send a signal to a quiet inhibitory neuron","thumbnail":""},{"id":"1775596078377","neuronKeys":["[#f11fe]","[#15036]","[#3f31c]","[#da8bf]","[#24196]","[#5d0e7]"],"edgeStrings":["[#f11fe]_#_[#15036]","[#3f31c]_#_[#da8bf]","[#da8bf]_#_[#60b5c]","[#5d0e7]_#_[#f11fe]","[#5d0e7]_#_[#24196]","[#24196]_#_[#5d0e7]"],"description":"With the highly active inhibitory neuron disabled by the Recurrent Pair’s output, the next trigger will be able to stimulate the inhibitory neuron that can turn off the Recurrent Pair of neurons.","thumbnail":""},{"id":"1775596257793","neuronKeys":["[#3f31c]","[#da8bf]","[#60b5c]","[#24196]","[#5d0e7]"],"edgeStrings":["[#3f31c]_#_[#da8bf]","[#da8bf]_#_[#24196]","[#da8bf]_#_[#60b5c]","[#60b5c]_#_[#24196]","[#60b5c]_#_[#5d0e7]","[#24196]_#_[#5d0e7]","[#5d0e7]_#_[#24196]"],"description":"Each time we trigger the remote control input neuron, we will toggle the Recurrent Pair of neurons on, then off, then on, then off!","thumbnail":""},{"id":"1775596392658","neuronKeys":["[#3f31c]"],"edgeStrings":[],"description":"The remote control neuron acts just like a quiet neuron when it is not receiving input from remote triggers. You can experiment by using SpikerBot’s other senses to trigger the lights!","thumbnail":""},{"id":"1775596455638","neuronKeys":["[#5d0e7]","[#24196]"],"edgeStrings":["[#24196]_#_[#5d0e7]","[#5d0e7]_#_[#24196]","[#5d0e7]_#_[#3535d]"],"description":"What other outputs or events can you control using the on/off Recurrent Pair of neurons? Can you make SpikerBot spin, or sing a tune?","thumbnail":""}],"info":{"title":"On and Off Switch","description":"Use a single remote control input button to toggle SpikerBot’s light output on and off.","author":"User","version":"1.0.1","timestamp":"2026-04-08T16:06:07.421740"}}