[#c654b]"],"description":"Experiment by controlling two inputs at once, or changing the strength of synapses connecting to the motors! Remember that you can see the strength of signals at a glance with the thickness of an axon.","thumbnail":""}],"info":{"title":"Keyboard Controlled Car","description":"Drive SpikerBot like a remote control car, using a keyboard!","author":"User","version":"1.0.1","timestamp":"2026-04-08T15:44:53.273530"}}