#b64b1]","[#b64b1]_#_[#0ce0d]","[#0ce0d]_#_[#9fd90]","[#0ce0d]_#_[#1e0da]"],"description":"When we see red, we will also Inhibit the memories of seeing green, or blue, to make sure we glow the correct color.","thumbnail":""},{"id":"1775518336646","neuronKeys":["[#c18da]","[#7c433]","[#9fd90]","[#16686]"],"edgeStrings":["[#782a6]_#_[#c18da]","[#c18da]_#_[#7c433]","[#c18da]_#_[#9fd90]","[#7c433]_#_[#4fb4e]","[#7c433]_#_[#1e0da]","[#16686]_#_[#9fd90]","[#9fd90]_#_[#16686]","[#9fd90]_#_[#eac80]"],"description":"When we see green, we excite the green memory, and inhibit red and blue memories","thumbnail":""},{"id":"1775518440924","neuronKeys":["[#3fa2f]","[#d9db2]","[#1e0da]","[#e9aa9]"],"edgeStrings":["[#782a6]_#_[#3fa2f]","[#d9db2]_#_[#9fd90]","[#d9db2]_#_[#4fb4e]","[#3fa2f]_#_[#d9db2]","[#3fa2f]_#_[#1e0da]","[#1e0da]_#_[#e9aa9]","[#1e0da]_#_[#eac80]","[#e9aa9]_#_[#1e0da]"],"description":"When we see blue we excite the blue memory and inhibit the red and green memories.","thumbnail":""},{"id":"1775518547538","neuronKeys":["[#0ce0d]","[#7c433]","[#d9db2]"],"edgeStrings":["[#b64b1]_#_[#0ce0d]","[#c18da]_#_[#7c433]","[#3fa2f]_#_[#d9db2]","[#d9db2]_#_[#9fd90]","[#d9db2]_#_[#4fb4e]","[#7c433]_#_[#1e0da]","[#7c433]_#_[#4fb4e]","[#0ce0d]_#_[#9fd90]","[#0ce0d]_#_[#1e0da]"],"description":"The act of inhibiting other  neurons while we stimulate a specific neuron or is called Lateral Inhibition, and is used often for action selection!","thumbnail":""},{"id":"1775518662324","neuronKeys":[],"edgeStrings":["[#782a6]_#_[#c18da]","[#782a6]_#_[#3fa2f]","[#782a6]_#_[#b64b1]"],"description":"What other types of signals might we need to monitor to help SpikerBot make decisions? Experiment with inputs and outputs for different attention and decision making!","thumbnail":""}],"info":{"title":"Cranial Chameleon","description":"Spikerbot changes color to blend in with red, green or blue objects!","author":"User","version":"1.0.1","timestamp":"2026-04-08T15:50:01.221200"}}