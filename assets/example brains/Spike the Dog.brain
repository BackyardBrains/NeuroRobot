54,238,143,222,122,85,164,188,98,214,220,5,119,139,136,132,66,214,80,1,135,135,172,132,11,61,0,0,0,0,0,0,0,0,24,171,146,193,57,74,17,45,92,0,0,0,0,0,0,0,192,51,84,152,143,37,84,160,3,0,0,0,0,0,0,0,144,6,1,58,0,0,0,0,0,0,0,0,105,16,160,3,0,0,0,0,0,0,0,144,6,1,58,0,0,0,0,0,0,0,0,105,16,160,3,0,0,0,0,0,0,0,144,6,1,58,0,0,0,0,0,0,0,0,105,16,160,3,0,0,0,0,0,0,0,144,198,255,7,29,162,217,60,133,28,237,27,0,0,0,0,73,69,78,68,174,66,96,130],"annotations":[{"id":"1775493516537","neuronKeys":["[#2d129]","[#1475c]","[#72726]","[#75496]","[#fd811]","[#c0385]","[#5aa1f]","[#49f6c]"],"edgeStrings":["[#7c418]_#_[#2d129]","[#2d129]_#_[#72726]","[#2d129]_#_[#1475c]","[#72726]_#_[#1475c]","[#1475c]_#_[#75496]","[#fd811]_#_[#75496]","[#75496]_#_[#fd811]","[#fd811]_#_[#a70e2]","[#eb955]_#_[#c0385]","[#c0385]_#_[#5ddba]","[#c0385]_#_[#d69ca]","[#75496]_#_[#c4cd7]","[#fd811]_#_[#f8046]","[#75496]_#_[#f8a7a]","[#2d129]_#_[#5aa1f]","[#5aa1f]_#_[#49f6c]","[#49f6c]_#_[#fd811]","[#5aa1f]_#_[#c0385]"],"description":"Spike builds off our ‘Watchdog’ brain. Please study that brain network to understand how it operates. Next, we will describe the new tricks Spike has learned!","thumbnail":""},{"id":"1775493599286","neuronKeys":["[#70880]","[#30225]","[#bdb82]"],"edgeStrings":["[#bdb82]_#_[#70880]","[#70880]_#_[#bdb82]","[#70880]_#_[#30225]","[#30225]_#_[#bdb82]","[#30225]_#_[#70880]","[#70880]_#_[#c4cd7]","[#70880]_#_[#f8a7a]"],"description":"The first new trick is that Spike can turn around to look for someone to play with when bored.","thumbnail":""},{"id":"1775493672532","neuronKeys":["[#bdb82]","[#70880]"],"edgeStrings":["[#70880]_#_[#bdb82]","[#bdb82]_#_[#70880]"],"description":"The bottom neuron is ocassionally active, and the top is quiet. When nothing is happening, the bottom neuron will fire, and stimulates the Recurrent Pair of neurons to activate and trigger a turning action.","thumbnail":""},{"id":"1775493735112","neuronKeys":["[#30225]"],"edgeStrings":["[#30225]_#_[#bdb82]","[#30225]_#_[#70880]","[#70880]_#_[#30225]"],"description":"After some time set by the delay neuron, Spike will stop briefly to see if it detects anyone.","thumbnail":""},{"id":"1775493894626","neuronKeys":["[#2d129]","[#72726]","[#17188]","[#15f36]","[#94d7b]","[#c0385]"],"edgeStrings":["[#7c418]_#_[#2d129]","[#2d129]_#_[#72726]","[#72726]_#_[#70880]","[#17188]_#_[#70880]","[#15f36]_#_[#17188]","[#4d021]_#_[#15f36]","[#94d7b]_#_[#bdb82]","[#c0385]_#_[#94d7b]","[#eb955]_#_[#c0385]"],"description":"When spike sees a person, hears a high pitch like a whistle, or when the distance sensor is blocked, Spike cannot turn around this way due to Inhibitory signals from those inputs.","thumbnail":""},{"id":"1775494075943","neuronKeys":["[#cd803]","[#c2c87]"],"edgeStrings":["[#cd803]_#_[#c4cd7]","[#eb955]_#_[#cd803]","[#c2c87]_#_[#a70e2]","[#eb955]_#_[#c2c87]"],"description":"Spike can also come to you if you whistle to it. This configuration is a classic Braitenberg Vehicle. If a person is seen in the right half of Spike’s vision, the left motor moves forward and turns Spike to the right. If a person is to the left,  it makes the right motor move and turns Spike left. If the person is centered, Spike will drive both motors and travel forward to you!","thumbnail":""},{"id":"1775494145366","neuronKeys":["[#e2a33]"],"edgeStrings":["[#e2a33]_#_[#cd803]","[#e2a33]_#_[#c2c87]"],"description":"However, this behavior is disabled by a highly active neuron that wants to fire all the time. By inhibiting this neuron, we can activate the seeking behavior.","thumbnail":""},{"id":"1775494295846","neuronKeys":["[#15f36]","[#97e6e]","[#c77d3]","[#17188]"],"edgeStrings":["[#4d021]_#_[#15f36]","[#97e6e]_#_[#15f36]","[#15f36]_#_[#17188]","[#15f36]_#_[#97e6e]","[#15f36]_#_[#c77d3]","[#c77d3]_#_[#15f36]","[#c77d3]_#_[#97e6e]","[#17188]_#_[#e2a33]","[#17188]_#_[#70880]","[#17188]_#_[#c0385]"],"description":"This network will be able to activate our network that approaches a person, while silencing other behaviors. It is activated with a higher pitched sound like a whistle.","thumbnail":""},{"id":"1775494426884","neuronKeys":["[#15f36]","[#97e6e]"],"edgeStrings":["[#15f36]_#_[#97e6e]","[#15f36]_#_[#c77d3]","[#97e6e]_#_[#15f36]","[#15f36]_#_[#17188]","[#4d021]_#_[#15f36]"],"description":"When a whistle is detected, we stimulate a Recurrent Pair that will allow Spikerbot to chase people for a window of time.","thumbnail":""},{"id":"1775494505292","neuronKeys":["[#c77d3]"],"edgeStrings":["[#c77d3]_#_[#15f36]","[#c77d3]_#_[#97e6e]"],"description":"After a few seconds, Spike will stop coming to you, as it gets nervous. Keep whistling to call it all the way to greet you!","thumbnail":""},{"id":"1775494687462","neuronKeys":["[#15f36]","[#c2c87]","[#cd803]","[#c0385]","[#2d129]","[#bdb82]"],"edgeStrings":["[#eb955]_#_[#c0385]","[#eb955]_#_[#c2c87]","[#eb955]_#_[#cd803]","[#7c418]_#_[#2d129]","[#e2a33]_#_[#cd803]","[#4d021]_#_[#15f36]"],"description":"Experiment with various inputs to change Spike the Dog’s behavior. Make Spike search with the press of a remote control neuron, chase or respond to other objects, or make spike avoid others!","thumbnail":""},{"id":"1775494929698","neuronKeys":[],"edgeStrings":["[#1475c]_#_[#d69ca]"],"description":"Spike will now also make a sound while it eats from your hand!","thumbnail":""}],"info":{"title":"Spike the Dog","description":"Spike builds off the Watchdog brain, and learns some new tricks! When Spike sees you, whistle to get it to come to you. When Spike is bored, it will spin around looking for someone to play with!","author":"User","version":"1.0.1","timestamp":"2026-04-08T15:19:31.236222"}}