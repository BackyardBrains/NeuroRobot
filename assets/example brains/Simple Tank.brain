t line?","thumbnail":""},{"id":"1775581666001","neuronKeys":[],"edgeStrings":["[#0bed8]_#_[#3391e]","[#f67b3]_#_[#f3f93]","[#c6b6c]_#_[#a6800]","[#2670d]_#_[#326e3]"],"description":"Tuning the motor synapses can help SpikerBot drive straight. You may need to adjust eachmotor synapse to a different value to get SpikerBot to behave consistantly.","thumbnail":""}],"info":{"title":"Simple Tank","description":"Drive each motor directly with two joysticks using remote control neurons!","author":"User","version":"1.0.1","timestamp":"2026-04-07T13:07:48.278634"}}